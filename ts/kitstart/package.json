{
  "name": "@evinvest/kitstart",
  "version": "0.0.0",
  "description": "Landing-site machinery for local-service brands: a site composition root, the Place/Presence/ServiceArea model with a publication gate, host/locale routing, schema.org and SEO builders, the lead funnel with its antispam, and analytics events. Pure core at '.', more subpaths per runtime.",
  "license": "BlueOak-1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EV-invest/lib.git",
    "directory": "ts/kitstart"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy/index.d.ts",
      "import": "./dist/proxy/index.js",
      "default": "./dist/proxy/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./next/config": {
      "types": "./dist/next/config/index.d.ts",
      "import": "./dist/next/config/index.js",
      "default": "./dist/next/config/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./testing/e2e": {
      "types": "./dist/testing/e2e.d.ts",
      "import": "./dist/testing/e2e.js",
      "default": "./dist/testing/e2e.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "bin": {
    "kitstart-size": "./dist/cli/kitstart-size.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fully-specify.mjs dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "node scripts/verify-pack.mjs",
    "check:template": "node scripts/check-template.mjs"
  },
  "peerDependencies": {
    "@evinvest/analytics": ">=0.3.0 <1",
    "@evinvest/i18n": ">=0.9.0 <1",
    "@evinvest/marketing": ">=0.3.0 <1",
    "@evinvest/uikit": ">=0.20.0 <1",
    "@playwright/test": ">=1.50",
    "next": "^16",
    "react": "^19",
    "server-only": "*",
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "@evinvest/uikit": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "server-only": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evinvest/analytics": "^0.3.0",
    "@evinvest/i18n": "^0.9.0",
    "@evinvest/marketing": "file:../marketing",
    "@evinvest/uikit": "file:../uikit",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "kitstartPack": [
    "template/package.json",
    "template/proxy.ts",
    "template/app/[locale]/[location]/layout.tsx",
    "dist/cli/kitstart-size.js"
  ]
}
